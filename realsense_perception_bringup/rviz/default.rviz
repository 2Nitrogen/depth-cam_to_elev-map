Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    # RViz2's TF display always shows every frame it discovers (the
    # "All Enabled: false" knob only applies to already-created frames;
    # newly-discovered ones default back to enabled). To pin the view to
    # exactly the two frames we care about regardless of what the bag /
    # camera wrapper publishes, use two Axes displays instead.
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.5
      Name: OdomAxes
      Radius: 0.025
      Reference Frame: odom
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.3
      Name: BaseLinkAxes
      Radius: 0.015
      Reference Frame: base_link
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 200; 200; 200
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: AccumulatedPoints
      Position Transformer: XYZ
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_elevation_map/accumulated_points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 0
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 0; 0
      Max Intensity: 0.1
      Min Color: 0; 255; 0
      Min Intensity: 0.0
      Name: ElevationCloud
      Position Transformer: XYZ
      Size (m): 0.025
      Style: Boxes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_elevation_map/points
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    # FastMesh: active when bringup is launched with mode:=fast_mesh.
    # The node publishes a MarkerArray with two markers: opaque POINTS
    # (id=0) for vertices + faint TRIANGLE_LIST (id=1) for face surfaces.
    # The elev_map and fast_mesh modes never run together, so each
    # mode's display sits idle (no traffic, no impact) when not selected.
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: FastMesh
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_fast_mesh/mesh
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: ColorImage
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/camera/color/image_raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Focal Point:
        X: 1.0
        Y: 0.0
        Z: 0.0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
